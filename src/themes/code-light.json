{
  "name": "Folio Light",
  "type": "light",
  "colors": {
    "editor.background": "#f2eee5",
    "editor.foreground": "#3a352d"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6e665c", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#6b4f1d" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#a2412c" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "entity.name.tag", "support.type", "entity.other.attribute-name"],
      "settings": { "foreground": "#2f4f7f" }
    },
    {
      "scope": ["entity.name.function", "support.function", "entity.name.class"],
      "settings": { "foreground": "#5c3f73" }
    },
    {
      "scope": ["variable", "variable.other", "punctuation", "keyword.operator", "meta.brace"],
      "settings": { "foreground": "#3a352d" }
    }
  ]
}
