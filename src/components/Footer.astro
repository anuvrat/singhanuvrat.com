---
const year = new Date().getFullYear();
---

<footer>
  <span>© {year} Anuvrat Singh</span>
  <span class="links">
    <a href="/rss.xml">RSS</a>
    <a href="https://github.com/anuvrat" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href="https://twitter.com/singhanuvrat" target="_blank" rel="noopener noreferrer">X</a>
    <a href="https://linkedin.com/in/singhanuvrat" target="_blank" rel="noopener noreferrer">LinkedIn</a>
  </span>
</footer>

<style>
  footer {
    padding: 44px 0 72px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 12.5px;
    color: var(--muted);
  }

  .links { display: flex; flex-wrap: wrap; }
  .links a { margin-left: 20px; color: inherit; }
  .links a:first-child { margin-left: 0; }
  a:hover { color: var(--ink); }

  @media (max-width: 700px) {
    footer { flex-direction: column; gap: 14px; }
    .links a { margin-left: 0; margin-right: 20px; }
  }
</style>
