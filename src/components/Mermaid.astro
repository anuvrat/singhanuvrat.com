---
interface Props {
  chart: string;
}

const { chart } = Astro.props;
---

<div class="mermaid-wrapper">
  <pre class="mermaid">{chart}</pre>
</div>

<style>
  .mermaid-wrapper {
    margin: var(--space-lg) 0;
    display: flex;
    justify-content: center;
  }

  .mermaid {
    background: none !important;
    border: none !important;
    padding: 0 !important;
  }

  @media (prefers-color-scheme: dark) {
    .mermaid {
      filter: invert(0.85) hue-rotate(180deg);
    }
  }
</style>

<script>
  import mermaid from 'mermaid';

  function initMermaid() {
    const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    mermaid.initialize({
      theme: isDark ? 'dark' : 'default',
      fontFamily: 'JetBrains Mono, ui-monospace, monospace',
      securityLevel: 'strict',
    });

    // Find all unrendered mermaid blocks and render them
    document.querySelectorAll('.mermaid:not([data-processed])').forEach((el) => {
      el.setAttribute('data-processed', 'true');
      mermaid.run({ nodes: [el as HTMLElement] });
    });
  }

  // Run on initial load
  initMermaid();

  // Re-run after View Transitions
  document.addEventListener('astro:after-swap', initMermaid);
</script>
