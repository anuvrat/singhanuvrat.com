---
import Diagram from './Diagram.astro';
import { formatMonthYear } from '../utils/formatDate';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  readingTime: string;
  cover?: string;
}

const { title, description, pubDate, slug, readingTime, cover } = Astro.props;
---

<article class="item">
  <a href={`/${slug}/`}>
    {cover && <Diagram src={cover} />}
    <div class="row">
      <h2>{title}</h2>
      <time datetime={pubDate.toISOString()}>{formatMonthYear(pubDate)}</time>
    </div>
    {description && <p>{description}</p>}
    <span class="more">Read · {readingTime} →</span>
  </a>
</article>

<style>
  .item {
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--rule);
  }

  a { display: block; color: inherit; }
  a:hover h2 { color: var(--accent); }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 28px;
  }

  h2 {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  time {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  p {
    color: var(--text-secondary);
    font-size: 13.5px;
    line-height: 1.85;
    margin: 12px 0 0;
  }

  .more {
    display: inline-block;
    margin-top: 16px;
    font-size: 12.5px;
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .item { padding: 40px 0 36px; }
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    time { order: -1; font-size: 12px; }
  }
</style>
