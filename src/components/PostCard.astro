---
import { formatDate } from '../utils/formatDate';
import { formatTag } from '../utils/formatTag';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  readingTime: string;
  tags?: string[];
}

const { title, description, pubDate, slug, readingTime, tags = [] } = Astro.props;
const formattedDate = formatDate(pubDate);
---

<a class="entry" href={`/${slug}/`}>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
  <p class="meta">
    {tags.map((tag, index) => (
      <>
        {index > 0 && <span aria-hidden="true">·</span>}
        <b>{formatTag(tag)}</b>
      </>
    ))}
    {tags.length > 0 && <span aria-hidden="true">·</span>}
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime} read</span>
  </p>
</a>

<style>
  .entry {
    display: block;
    padding-bottom: 40px;
    color: inherit;
    text-decoration: none;
  }

  .entry + .entry {
    border-top: 1px solid var(--rule);
    padding-top: 36px;
  }

  h2 {
    font-size: 30px;
    line-height: 1.22;
    font-weight: 400;
    letter-spacing: -0.018em;
    color: var(--ink);
    max-width: 680px;
  }

  .entry:hover h2 { color: var(--accent); }

  p {
    margin-top: 12px;
    font-size: 18.5px;
    line-height: 1.6;
    color: var(--dek);
    max-width: 640px;
    text-wrap: pretty;
  }

  .meta {
    margin-top: 16px;
    font-family: var(--sans);
    font-size: 12.5px;
    color: var(--muted);
    letter-spacing: 0.01em;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: baseline;
    max-width: none;
  }

  b {
    font-weight: 500;
    color: var(--accent);
  }

  @media (max-width: 700px) {
    h2 { font-size: 24px; }
    p { font-size: 17px; }
  }
</style>
