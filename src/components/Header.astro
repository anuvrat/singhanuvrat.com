---
import Logo from './Logo.astro';

const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <a class="brand" href="/">
    <Logo size={34} />
    <span>
      <b>Anuvrat</b>
      <small>Thinking in systems</small>
    </span>
  </a>
  <nav aria-label="Site">
    <a href="/" class:list={{ on: isHome }} aria-current={isHome ? 'page' : undefined}>Writing</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</header>

<style>
  .site-header {
    padding: 56px 0 28px;
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    min-width: 0;
  }

  .brand b {
    display: block;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .brand small {
    display: block;
    color: var(--muted);
    font-size: 12.5px;
    margin-top: 3px;
    line-height: 1.3;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 13px;
    color: var(--muted);
    flex-shrink: 0;
  }

  nav a.on,
  nav a:hover { color: var(--ink); }

  @media (max-width: 700px) {
    .site-header { padding: 36px 0 22px; }
    nav { display: none; }
  }
</style>
