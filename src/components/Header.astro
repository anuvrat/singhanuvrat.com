---
import Logo from './Logo.astro';
---

<header class="site-header">
  <a class="brand" href="/">
    <Logo />
    <span>Anuvrat</span>
  </a>
  <nav aria-label="Site">
    <a class="on" href="/" aria-current="page">Essays</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 36px 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    min-width: 0;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 30px;
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--muted);
    flex-shrink: 0;
  }

  nav a.on { color: var(--ink); }

  nav a:hover { color: var(--ink); }

  @media (max-width: 700px) {
    .site-header { padding: 24px 0; }

    nav a:not(.on) { display: none; }
  }
</style>
