---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
  class?: string;
}

const { src, alt, caption, width, class: className } = Astro.props;
---

<figure class:list={['post-image', className]}>
  <Image
    src={src}
    alt={alt}
    width={width}
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .post-image {
    margin: var(--space-xl) 0;
  }

  .post-image img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--border);
  }

  figcaption {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: center;
    font-style: italic;
  }
</style>
