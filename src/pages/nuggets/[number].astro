---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const nuggets = await getCollection('nuggets', ({ data }) => !data.draft);

  return nuggets.map((nugget) => ({
    params: { number: nugget.data.number.toString() },
    props: { nugget },
  }));
}

const { nugget } = Astro.props;
const { Content } = await nugget.render();

// Get prev/next nuggets for navigation
const allNuggets = (await getCollection('nuggets', ({ data }) => !data.draft))
  .sort((a, b) => a.data.number - b.data.number);

const currentIndex = allNuggets.findIndex((n) => n.data.number === nugget.data.number);
const prevNugget = currentIndex > 0 ? allNuggets[currentIndex - 1] : null;
const nextNugget = currentIndex < allNuggets.length - 1 ? allNuggets[currentIndex + 1] : null;
---

<BaseLayout
  title={`${nugget.data.title} — Anuvrat`}
  description={`Curated links and commentary: ${nugget.data.dateRange}`}
>
  <article class="nugget">
    <header class="nugget-header">
      <div class="nugget-meta">
        <a href="/nuggets/" class="back-link">← All Nuggets</a>
        <span class="date">{nugget.data.dateRange}</span>
      </div>
      <h1>
        <span class="number">#{nugget.data.number}</span>
      </h1>
    </header>

    <div class="nugget-content">
      <Content />
    </div>

    {(prevNugget || nextNugget) && (
      <nav class="nugget-nav">
        {prevNugget ? (
          <a href={`/nuggets/${prevNugget.data.number}/`} class="nav-link prev">
            <span class="direction">← Previous</span>
            <span class="label">#{prevNugget.data.number}</span>
          </a>
        ) : (
          <div class="nav-placeholder"></div>
        )}
        {nextNugget ? (
          <a href={`/nuggets/${nextNugget.data.number}/`} class="nav-link next">
            <span class="direction">Next →</span>
            <span class="label">#{nextNugget.data.number}</span>
          </a>
        ) : (
          <div class="nav-placeholder"></div>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .nugget {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .nugget-header {
    margin-bottom: var(--space-xl);
  }

  .nugget-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
  }

  .back-link {
    color: var(--text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .date {
    color: var(--text-muted);
  }

  .nugget-header h1 {
    font-size: var(--text-2xl);
    margin: 0;
  }

  .number {
    color: var(--accent);
  }

  .nugget-content {
    /* Inherit global typography */
  }

  .nugget-content :global(h2) {
    font-size: var(--text-lg);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    color: var(--text-muted);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nugget-content :global(h2:first-child) {
    margin-top: 0;
  }

  .nugget-content :global(ul) {
    list-style: none;
    padding: 0;
  }

  .nugget-content :global(ul li) {
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--border);
  }

  .nugget-content :global(ul li:last-child) {
    border-bottom: none;
  }

  .nugget-nav {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    color: var(--text);
    padding: var(--space-sm);
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .nav-link:hover {
    background-color: var(--bg-secondary);
  }

  .nav-link.next {
    text-align: right;
  }

  .nav-link .direction {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .nav-link .label {
    font-weight: 700;
    color: var(--accent);
  }

  .nav-placeholder {
    flex: 1;
  }
</style>
