---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const nuggets = await getCollection('nuggets', ({ data }) => !data.draft);

  return nuggets.map((nugget) => ({
    params: { number: nugget.data.number.toString() },
    props: { nugget },
  }));
}

const { nugget } = Astro.props;
const { Content } = await nugget.render();

// Get prev/next nuggets for navigation
const allNuggets = (await getCollection('nuggets', ({ data }) => !data.draft))
  .sort((a, b) => a.data.number - b.data.number);

const currentIndex = allNuggets.findIndex((n) => n.data.number === nugget.data.number);
const prevNugget = currentIndex > 0 ? allNuggets[currentIndex - 1] : null;
const nextNugget = currentIndex < allNuggets.length - 1 ? allNuggets[currentIndex + 1] : null;
---

<BaseLayout
  title={`${nugget.data.title} — Anuvrat`}
  description={`Curated links and commentary: ${nugget.data.dateRange}`}
>
  <article class="nugget">
    <header class="nugget-header">
      <div class="nugget-meta">
        <a href="/nuggets/" class="back-link">← All Nuggets</a>
        <span class="date">{nugget.data.dateRange}</span>
      </div>
      <h1>{nugget.data.title}</h1>
    </header>

    <div class="nugget-content">
      <Content />
    </div>

    {(nugget.data.song || nugget.data.podcast) && (
      <footer class="nugget-footer">
        {nugget.data.song && (
          <span class="footer-item">
            <span class="footer-icon">♫</span>
            {nugget.data.song.url ? (
              <a href={nugget.data.song.url} target="_blank" rel="noopener noreferrer">
                {nugget.data.song.title}
              </a>
            ) : (
              <span>{nugget.data.song.title}</span>
            )}
            {' '}by {nugget.data.song.artist}
          </span>
        )}
        {nugget.data.song && nugget.data.podcast && (
          <span class="footer-sep">·</span>
        )}
        {nugget.data.podcast && (
          <span class="footer-item">
            <span class="footer-icon">🎙</span>
            {nugget.data.podcast.url ? (
              <a href={nugget.data.podcast.url} target="_blank" rel="noopener noreferrer">
                {nugget.data.podcast.title}
              </a>
            ) : (
              <span>{nugget.data.podcast.title}</span>
            )}
          </span>
        )}
      </footer>
    )}

    {(prevNugget || nextNugget) && (
      <nav class="nugget-nav">
        {prevNugget ? (
          <a href={`/nuggets/${prevNugget.data.number}/`} class="nav-link prev">
            <span class="direction">← Previous</span>
            <span class="label">{prevNugget.data.title}</span>
          </a>
        ) : (
          <div class="nav-placeholder"></div>
        )}
        {nextNugget ? (
          <a href={`/nuggets/${nextNugget.data.number}/`} class="nav-link next">
            <span class="direction">Next →</span>
            <span class="label">{nextNugget.data.title}</span>
          </a>
        ) : (
          <div class="nav-placeholder"></div>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .nugget {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .nugget-header {
    margin-bottom: var(--space-xl);
  }

  .nugget-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
  }

  .back-link {
    color: var(--text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .date {
    color: var(--text-muted);
  }

  .nugget-header h1 {
    font-size: var(--text-xl);
    margin: 0;
    font-weight: 700;
  }

  .nugget-content :global(h2) {
    font-size: var(--text-lg);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-lg);
    font-weight: 700;
  }

  .nugget-content :global(h2:first-child) {
    margin-top: 0;
  }

  /* Top-level list: no bullets, separated by lines */
  .nugget-content :global(> ul) {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nugget-content :global(> ul > li) {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border);
  }

  .nugget-content :global(> ul > li:first-child) {
    padding-top: 0;
  }

  .nugget-content :global(> ul > li:last-child) {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Nested lists: subtle, indented */
  .nugget-content :global(ul ul) {
    list-style: disc;
    padding-left: var(--space-xl);
    margin-top: var(--space-sm);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--line-height);
  }

  .nugget-content :global(ul ul li) {
    margin-bottom: var(--space-xs);
  }

  .nugget-content :global(ul ul li:last-child) {
    margin-bottom: 0;
  }

  .nugget-content :global(ul ul li::marker) {
    color: var(--border);
  }

  .nugget-footer {
    margin-top: var(--space-2xl);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .footer-item {
    display: inline;
  }

  .footer-icon {
    margin-right: var(--space-xs);
  }

  .footer-sep {
    margin: 0 var(--space-sm);
    color: var(--border);
  }

  .nugget-footer a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
  }

  .nugget-footer a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .nugget-nav {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    color: var(--text);
    padding: var(--space-sm);
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .nav-link:hover {
    background-color: var(--bg-secondary);
  }

  .nav-link.next {
    text-align: right;
  }

  .nav-link .direction {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .nav-link .label {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .nav-placeholder {
    flex: 1;
  }
</style>
