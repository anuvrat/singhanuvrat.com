---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const nuggets = (await getCollection('nuggets', ({ data }) => !data.draft))
  .sort((a, b) => b.data.number - a.data.number);

const hasNuggets = nuggets.length > 0;
---

<BaseLayout
  title="Nuggets — Anuvrat"
  description="Bi-weekly curated links and commentary on distributed systems, infrastructure, and technology."
>
  <div class="nuggets-page">
    <header class="page-header">
      <h1>Nuggets</h1>
      <p class="subtitle">Bi-weekly curated links and commentary from my research.</p>
    </header>

    {hasNuggets ? (
      <ul class="nuggets-list">
        {nuggets.map((nugget) => (
          <li>
            <a href={`/nuggets/${nugget.data.number}/`} class="nugget-link">
              <span class="nugget-number">#{nugget.data.number}</span>
              <span class="nugget-date">{nugget.data.dateRange}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty-state">
        <p>No nuggets yet. Check back soon for curated links and commentary.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .nuggets-page {
    max-width: var(--content-width);
  }

  .page-header {
    margin-bottom: var(--space-2xl);
  }

  .page-header h1 {
    margin-bottom: var(--space-sm);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: var(--text-base);
    margin-top: 0;
  }

  .nuggets-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .nuggets-list li {
    border-bottom: 1px solid var(--border);
  }

  .nugget-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) 0;
    text-decoration: none;
    color: var(--text);
    transition: color 0.2s ease;
  }

  .nugget-link:hover {
    color: var(--accent);
  }

  .nugget-number {
    font-weight: 700;
    font-size: var(--text-lg);
  }

  .nugget-link:hover .nugget-number {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nugget-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .empty-state {
    padding: var(--space-2xl) 0;
    text-align: center;
    color: var(--text-muted);
  }

  .empty-state p {
    margin: 0;
  }
</style>
