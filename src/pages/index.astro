---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WebsiteSchema from '../components/WebsiteSchema.astro';
import PostCard from '../components/PostCard.astro';
import { getReadingTime } from '../utils/readingTime';

const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group posts by year
const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<BaseLayout title="Anuvrat — Thinking in systems" description="Thoughts on distributed systems, infrastructure, and the engineering trade-offs that shape how we build resilient, scalable systems.">
  <WebsiteSchema />
  <div class="post-list">
    {years.map((year) => (
      <section class="year-section">
        <h2 class="year-header">{year}</h2>
        <div class="year-posts">
          {postsByYear[year].map((post) => {
            const readingTime = getReadingTime(post.body || '');
            return (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={post.slug}
                readingTime={readingTime}
              />
            );
          })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .post-list {
    max-width: var(--content-width);
  }

  .year-section {
    margin-bottom: var(--space-2xl);
  }

  .year-section:last-child {
    margin-bottom: 0;
  }

  .year-header {
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
    letter-spacing: 0.05em;
  }

  .year-posts {
    border-top: 1px solid var(--border);
  }
</style>
