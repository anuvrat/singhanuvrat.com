---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WebsiteSchema from '../components/WebsiteSchema.astro';
import PostCard from '../components/PostCard.astro';
import { getReadingTime } from '../utils/readingTime';

const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.pubDate.getUTCFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<BaseLayout title="Anuvrat — Thinking in systems" description="Thoughts on distributed systems, infrastructure, and the engineering trade-offs that shape how we build resilient, scalable systems.">
  <WebsiteSchema />
  <section class="intro">
    <h1>Thinking in <em>systems</em>.</h1>
  </section>
  {years.map((year) => (
    <section class="year">
      <p class="year-label">{year}</p>
      <div>
        {postsByYear[year].map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            readingTime={getReadingTime(post.body || '')}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 48px;
    padding: 110px 0 88px;
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    grid-column: 2;
    font-size: 88px;
    line-height: 0.98;
    font-weight: 300;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
  }

  .year {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 48px;
    border-bottom: 1px solid var(--rule);
    padding: 56px 0 24px;
  }

  .year-label {
    font-size: 30px;
    font-weight: 300;
    font-style: italic;
    color: var(--muted);
    line-height: 1.2;
    padding-top: 2px;
  }

  @media (max-width: 700px) {
    .intro {
      display: block;
      padding: 64px 0 56px;
    }

    h1 { font-size: 54px; }

    .year {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 40px 0 12px;
    }

    .year-label { font-size: 24px; }
  }
</style>
