---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonSchema from '../components/PersonSchema.astro';
---

<BaseLayout title="About — Anuvrat" description="Anuvrat Singh — Engineer with 15+ years building distributed systems and infrastructure">
  <PersonSchema />

  <div class="about">
    <h1>About</h1>

    <p>
      I'm Anuvrat Singh, an engineer with 15+ years of experience building distributed systems and infrastructure platforms.
    </p>

    <p>
      I've built scalable AI/ML platforms with a focus on privacy, trust, and developer experience.
    </p>

    <h2>What I write about</h2>

    <p>
      This blog is where I explore the ideas and trade-offs that shape how we build resilient, scalable systems. Topics include:
    </p>

    <ul>
      <li>Distributed systems design and architecture</li>
      <li>Infrastructure and platform engineering</li>
      <li>Lessons from classic papers (Spanner, Bigtable, etc.)</li>
      <li>AI/ML infrastructure at scale</li>
    </ul>

    <h2>Elsewhere</h2>

    <ul class="links">
      <li><a href="https://github.com/anuvrat" target="_blank" rel="noopener">GitHub</a></li>
      <li><a href="https://linkedin.com/in/singhanuvrat" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href="https://twitter.com/singhanuvrat" target="_blank" rel="noopener">Twitter/X</a></li>
    </ul>

    <h2>Get in touch</h2>

    <p>
      The best way to reach me is on <a href="https://twitter.com/singhanuvrat" target="_blank" rel="noopener">Twitter/X</a> or <a href="https://linkedin.com/in/singhanuvrat" target="_blank" rel="noopener">LinkedIn</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: var(--content-width);
  }

  h1 {
    margin-bottom: var(--space-xl);
  }

  h2 {
    margin-top: var(--space-2xl);
    font-size: var(--text-lg);
  }

  p {
    margin-top: var(--space-md);
  }

  ul {
    margin-top: var(--space-md);
  }

  .links {
    list-style: none;
    padding: 0;
  }

  .links li {
    margin-top: var(--space-sm);
  }
</style>
