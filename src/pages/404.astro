---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — Anuvrat" description="The page you're looking for doesn't exist.">
  <div class="not-found">
    <h1>404</h1>
    <p>The page you're looking for doesn't exist.</p>
    <a href="/">← Writing</a>
  </div>
</BaseLayout>

<style>
  .not-found { padding: 56px 0 24px; }
  h1 { font-size: 28px; margin-bottom: 18px; }
  p {
    color: var(--text-secondary);
    font-size: 14.5px;
    line-height: 1.9;
    margin-bottom: 18px;
  }
  a { font-size: 13px; color: var(--muted); }
  a:hover { color: var(--ink); }
</style>
