---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  hasMath?: boolean;
}

const { title, description = "Thinking in systems", ogImage, hasMath = false } = Astro.props;
const isHome = Astro.url.pathname === '/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#221e1a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {isHome ? (
      <>
        <link rel="preload" href="/fonts/newsreader-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/newsreader-latin-300-italic.woff2" as="font" type="font/woff2" crossorigin />
      </>
    ) : (
      <link rel="preload" href="/fonts/newsreader-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    )}

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}

    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

    {hasMath && (
      <>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" integrity="sha384-GvrOXuhMATgEsSwCs4smOFZETl1RdNStrgjcCeFQhB98kRCOE96N5Rqn4GnQe8Rj" crossorigin="anonymous" />
      </>
    )}

    <ClientRouter />

    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <div class="wrap">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      function initPostFeatures() {
        document.querySelectorAll('.post-content h2[id], .post-content h3[id]').forEach(heading => {
          if (heading.querySelector('.anchor')) return;

          const anchor = document.createElement('a');
          anchor.className = 'anchor';
          anchor.href = `#${heading.id}`;
          anchor.textContent = '#';
          anchor.setAttribute('aria-label', `Copy link to ${heading.textContent}`);

          anchor.addEventListener('click', async (e) => {
            e.preventDefault();
            const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
            await navigator.clipboard.writeText(url);
            anchor.textContent = '✓';
            anchor.classList.add('copied');
            setTimeout(() => {
              anchor.textContent = '#';
              anchor.classList.remove('copied');
            }, 1500);
            history.pushState(null, '', `#${heading.id}`);
          });

          heading.insertBefore(anchor, heading.firstChild);
        });

        document.querySelectorAll('pre.astro-code').forEach((pre) => {
          if (pre.querySelector('.copy-button')) return;

          const button = document.createElement('button');
          button.className = 'copy-button';
          button.setAttribute('aria-label', 'Copy code');
          button.textContent = 'Copy';

          button.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.textContent || '';
            await navigator.clipboard.writeText(code);
            button.textContent = 'Copied';
            button.classList.add('copied');
            setTimeout(() => {
              button.textContent = 'Copy';
              button.classList.remove('copied');
            }, 2000);
          });

          pre.appendChild(button);
        });
      }

      initPostFeatures();
      document.addEventListener('astro:after-swap', initPostFeatures);
    </script>
  </body>
</html>
