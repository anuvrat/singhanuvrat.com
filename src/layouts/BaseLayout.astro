---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  hasMath?: boolean;
}

const { title, description = "Thinking in systems", ogImage, hasMath = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

    {/* KaTeX for math rendering - only load when needed */}
    {hasMath && (
      <>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" integrity="sha384-GvrOXuhMATgEsSwCs4smOFZETl1RdNStrgjcCeFQhB98kRCOE96N5Rqn4GnQe8Rj" crossorigin="anonymous" />
      </>
    )}

    <!-- View transitions for smooth page navigation -->
    <ClientRouter />

    <style is:global>
      @import '../styles/global.css';
    </style>

    <!-- Dark mode script (inline to prevent flash) -->
    <script is:inline>
      function applyTheme() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }

      // Apply on initial load
      applyTheme();

      // Re-apply after View Transitions swap
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body>
    <Header />
    <main class="main-content">
      <slot />
    </main>
    <Footer />

    <!-- Post enhancements: anchor links + code copy buttons -->
    <script>
      function initPostFeatures() {
        // Anchor links on headings (click to copy URL)
        document.querySelectorAll('.post-content h2[id], .post-content h3[id]').forEach(heading => {
          if (heading.querySelector('.anchor')) return; // Already initialized

          const anchor = document.createElement('a');
          anchor.className = 'anchor';
          anchor.href = `#${heading.id}`;
          anchor.textContent = '#';
          anchor.setAttribute('aria-label', `Copy link to ${heading.textContent}`);

          anchor.addEventListener('click', async (e) => {
            e.preventDefault();
            const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
            await navigator.clipboard.writeText(url);
            anchor.textContent = '✓';
            anchor.classList.add('copied');
            setTimeout(() => {
              anchor.textContent = '#';
              anchor.classList.remove('copied');
            }, 1500);
            history.pushState(null, '', `#${heading.id}`);
          });

          heading.insertBefore(anchor, heading.firstChild);
        });

        // Copy button for code blocks
        document.querySelectorAll('pre').forEach((pre) => {
          if (pre.querySelector('.copy-button')) return; // Already initialized

          const button = document.createElement('button');
          button.className = 'copy-button';
          button.setAttribute('aria-label', 'Copy code');
          button.textContent = 'Copy';

          button.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.textContent || '';
            await navigator.clipboard.writeText(code);
            button.textContent = 'Copied!';
            button.classList.add('copied');
            setTimeout(() => {
              button.textContent = 'Copy';
              button.classList.remove('copied');
            }, 2000);
          });

          pre.appendChild(button);
        });
      }

      initPostFeatures();
      document.addEventListener('astro:after-swap', initPostFeatures);
    </script>
  </body>
</html>

<style is:global>
  .main-content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
    /* Header ~60px + Footer ~80px + margins ~60px = ~200px */
    min-height: calc(100vh - 200px);
  }

  .copy-button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.25rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  pre:hover .copy-button {
    opacity: 1;
  }

  /* Always show copy button on touch devices */
  @media (hover: none) {
    .copy-button {
      opacity: 0.7;
    }
  }

  .copy-button:hover {
    color: var(--text);
  }

  .copy-button.copied {
    color: var(--accent);
  }
</style>
