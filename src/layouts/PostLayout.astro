---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleSchema from '../components/ArticleSchema.astro';
import Diagram from '../components/Diagram.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SeriesNav from '../components/SeriesNav.astro';
import { getReadingTime } from '../utils/readingTime';
import { formatDate, UPDATED_THRESHOLD_MS } from '../utils/formatDate';
import { findRelatedPosts } from '../utils/relatedPosts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  headings: { depth: number; slug: string; text: string }[];
  body: string;
  ogImage?: string;
  cover?: string;
  currentPost: CollectionEntry<'posts'>;
  allPosts: CollectionEntry<'posts'>[];
}

const {
  title, description, pubDate, updatedDate, headings, body, ogImage, cover, currentPost, allPosts,
} = Astro.props;

const difficultyLabels: Record<string, string> = {
  'intro': 'Intro',
  'intermediate': 'Intermediate',
  'deep-dive': 'Deep-dive',
};
const difficulty = currentPost.data.difficulty;
const difficultyLabel = difficulty ? difficultyLabels[difficulty] : null;

const slug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const autoOgImage = new URL(`/og/${slug}.png`, Astro.site).toString();
const finalOgImage = ogImage || autoOgImage;
const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
const showUpdated = updatedDate && (updatedDate.getTime() - pubDate.getTime()) > UPDATED_THRESHOLD_MS;
const readingTime = getReadingTime(body);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedPosts = findRelatedPosts(currentPost, allPosts, 3);
const hasMath = /\$\$[\s\S]+?\$\$|\$[^$\n]+?\$/.test(body);
---

<BaseLayout
  title={`${title} — Anuvrat`}
  description={description}
  ogImage={finalOgImage}
  hasMath={hasMath}
  variant="post"
  headings={headings}
>
  <ArticleSchema
    title={title}
    description={description}
    pubDate={pubDate}
    updatedDate={updatedDate}
    url={canonicalUrl}
    ogImage={finalOgImage}
  />

  <article>
    <h1>{title}</h1>
    <div class="meta">
      <span>Anuvrat Singh</span>
      <span aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime}</span>
      {difficultyLabel && <span class="pill">{difficultyLabel}</span>}
      {showUpdated && (
        <>
          <span aria-hidden="true">·</span>
          <span>Updated {formattedUpdatedDate}</span>
        </>
      )}
    </div>
    {cover && <Diagram src={cover} lead />}
    <div class="post-content">
      <slot />
    </div>
    <div class="post-end">
      {currentPost.data.series ? (
        <SeriesNav currentPost={currentPost} allPosts={allPosts} />
      ) : (
        <RelatedPosts posts={relatedPosts} />
      )}
    </div>
  </article>
</BaseLayout>

<style>
  h1 {
    font-size: 28px;
    line-height: 1.35;
    letter-spacing: -0.02em;
    margin: 48px 0 18px;
    font-weight: 700;
  }

  .meta {
    font-size: 12.5px;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-bottom: 34px;
  }

  .pill {
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .post-end {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 700px) {
    h1 { font-size: 23px; }
  }
</style>
