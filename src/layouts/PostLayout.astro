---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleSchema from '../components/ArticleSchema.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SeriesNav from '../components/SeriesNav.astro';
import { getReadingTime } from '../utils/readingTime';
import { formatDate, UPDATED_THRESHOLD_MS } from '../utils/formatDate';
import { formatTag } from '../utils/formatTag';
import { findRelatedPosts } from '../utils/relatedPosts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  body: string;
  ogImage?: string;
  currentPost: CollectionEntry<'posts'>;
  allPosts: CollectionEntry<'posts'>[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  body,
  ogImage,
  currentPost,
  allPosts,
} = Astro.props;

const difficultyLabels: Record<string, string> = {
  'intro': 'Intro',
  'intermediate': 'Intermediate',
  'deep-dive': 'Deep dive',
};
const difficulty = currentPost.data.difficulty;
const difficultyLabel = difficulty ? difficultyLabels[difficulty] : null;
const tags = (currentPost.data.tags ?? []).map(formatTag);

const slug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const autoOgImage = new URL(`/og/${slug}.png`, Astro.site).toString();
const finalOgImage = ogImage || autoOgImage;

const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
const showUpdated = updatedDate &&
  (updatedDate.getTime() - pubDate.getTime()) > UPDATED_THRESHOLD_MS;

const readingTime = getReadingTime(body);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedPosts = findRelatedPosts(currentPost, allPosts, 3);
const hasMath = /\$\$[\s\S]+?\$\$|\$[^$\n]+?\$/.test(body);
const kicker = [...tags, ...(difficultyLabel ? [difficultyLabel] : [])];
---

<BaseLayout
  title={`${title} — Anuvrat`}
  description={description}
  ogImage={finalOgImage}
  hasMath={hasMath}
>
  <ArticleSchema
    title={title}
    description={description}
    pubDate={pubDate}
    updatedDate={updatedDate}
    url={canonicalUrl}
    ogImage={finalOgImage}
  />

  <article>
    <header class="ph">
      {kicker.length > 0 && <p class="kicker">{kicker.join(' · ')}</p>}
      <h1>{title}</h1>
      {description && <p class="dek">{description}</p>}
      <p class="by">
        <b>Anuvrat Singh</b>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} read</span>
        {showUpdated && (
          <>
            <span aria-hidden="true">·</span>
            <span>Updated {formattedUpdatedDate}</span>
          </>
        )}
      </p>
    </header>
    <div class="orn" aria-hidden="true"></div>

    <div class="post-content">
      <slot />
    </div>

    <div class="post-end">
      {currentPost.data.series ? (
        <SeriesNav currentPost={currentPost} allPosts={allPosts} />
      ) : (
        <RelatedPosts posts={relatedPosts} />
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .ph {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    padding: 96px 0 56px;
  }

  .kicker {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 28px;
  }

  h1 {
    font-size: 54px;
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.028em;
    color: var(--ink);
    text-wrap: balance;
  }

  .dek {
    font-size: 22px;
    line-height: 1.5;
    color: var(--dek);
    font-weight: 400;
    font-style: italic;
    text-wrap: balance;
    margin: 26px auto 0;
    max-width: 640px;
  }

  .by {
    margin-top: 34px;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    align-items: center;
  }

  .by b {
    color: var(--ink);
    font-weight: 500;
  }

  .orn {
    width: 56px;
    height: 1px;
    background: var(--accent);
    margin: 0 auto 64px;
    opacity: 0.6;
  }

  .post-end {
    max-width: 660px;
    margin: 56px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 700px) {
    .ph { padding: 48px 0 32px; }
    h1 { font-size: 36px; }
    .dek { font-size: 19px; }
    .orn { margin-bottom: 40px; }
  }
</style>
