---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleSchema from '../components/ArticleSchema.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SeriesNav from '../components/SeriesNav.astro';
import TocDots from '../components/TocDots.astro';
import { getReadingTime } from '../utils/readingTime';
import { formatDate, UPDATED_THRESHOLD_MS } from '../utils/formatDate';
import { findRelatedPosts } from '../utils/relatedPosts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  headings: { depth: number; slug: string; text: string }[];
  body: string;
  ogImage?: string;
  currentPost: CollectionEntry<'posts'>;
  allPosts: CollectionEntry<'posts'>[];
}

const { title, description, pubDate, updatedDate, headings, body, ogImage, currentPost, allPosts } = Astro.props;

// Difficulty display mapping
const difficultyLabels: Record<string, string> = {
  'intro': 'Intro',
  'intermediate': 'Intermediate',
  'deep-dive': 'Deep-dive',
};
const difficulty = currentPost.data.difficulty;
const difficultyLabel = difficulty ? difficultyLabels[difficulty] : null;

// Auto-generate OG image URL if not provided
const slug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const autoOgImage = new URL(`/og/${slug}.png`, Astro.site).toString();
const finalOgImage = ogImage || autoOgImage;

const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;

// Show updated date only if it's more than 7 days after pubDate
const showUpdated = updatedDate &&
  (updatedDate.getTime() - pubDate.getTime()) > UPDATED_THRESHOLD_MS;

const readingTime = getReadingTime(body);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedPosts = findRelatedPosts(currentPost, allPosts, 3);
---

<BaseLayout title={`${title} — Anuvrat`} description={description} ogImage={finalOgImage}>
  <ArticleSchema
    title={title}
    description={description}
    pubDate={pubDate}
    updatedDate={updatedDate}
    url={canonicalUrl}
    ogImage={finalOgImage}
  />

  <TocDots headings={headings} />

  <article class="post">
    <div class="post-layout">
      <div class="content-column">
        <header class="post-header">
          <h1>{title}</h1>
          <div class="post-meta">
            <a href="/about/" class="author">Anuvrat Singh</a>
            <span class="separator">·</span>
            <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
            <span class="separator">·</span>
            <span>{readingTime}</span>
            {difficultyLabel && (
              <>
                <span class="separator">·</span>
                <span class={`difficulty difficulty-${difficulty}`}>{difficultyLabel}</span>
              </>
            )}
            {showUpdated && (
              <>
                <span class="separator">·</span>
                <span class="updated">Updated {formattedUpdatedDate}</span>
              </>
            )}
          </div>
        </header>

        <div class="post-content">
          <slot />
        </div>

        <footer class="post-footer">
          {currentPost.data.series ? (
            <SeriesNav currentPost={currentPost} allPosts={allPosts} />
          ) : (
            <RelatedPosts posts={relatedPosts} />
          )}
        </footer>
      </div>

      <aside class="margin-column">
        <!-- Margin notes will be positioned here via CSS -->
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .post-layout {
      grid-template-columns: var(--content-width) var(--sidebar-width);
      gap: var(--space-xl);
    }
  }

  .margin-column {
    display: none;
  }

  @media (min-width: 1024px) {
    .margin-column {
      display: block;
    }
  }

  .content-column {
    min-width: 0; /* Prevent overflow */
  }

  .post-header {
    margin-bottom: var(--space-xl);
  }

  .post-header h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-sm);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .author {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }

  .author:hover {
    color: var(--accent);
  }

  .separator {
    color: var(--text-muted);
  }

  .updated {
    font-style: italic;
  }

  .difficulty {
    font-size: 0.7rem;
    padding: 0.15em 0.5em;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 500;
  }

  .difficulty-intro {
    background: var(--bg-secondary);
    color: var(--text-muted);
  }

  .difficulty-intermediate {
    background: var(--bg-secondary);
    color: var(--text);
  }

  .difficulty-deep-dive {
    background: var(--bg-secondary);
    color: var(--accent);
  }

  .post-content {
    position: relative;
  }

  .post-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }
</style>
