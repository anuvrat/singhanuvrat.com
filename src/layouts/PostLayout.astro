---
import BaseLayout from './BaseLayout.astro';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  headings: { depth: number; slug: string; text: string }[];
  body: string;
  ogImage?: string;
}

const { title, description, pubDate, updatedDate, body, ogImage } = Astro.props;

// Auto-generate OG image URL if not provided
const slug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const autoOgImage = new URL(`/og/${slug}.png`, Astro.site).toString();
const finalOgImage = ogImage || autoOgImage;

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// Show updated date only if it's more than 7 days after pubDate
const showUpdated = updatedDate &&
  (updatedDate.getTime() - pubDate.getTime()) > 7 * 24 * 60 * 60 * 1000;

const readingTime = getReadingTime(body);
---

<BaseLayout title={`${title} — Anuvrat`} description={description} ogImage={finalOgImage}>
  <article class="post">
    <div class="post-layout">
      <div class="content-column">
        <header class="post-header">
          <h1>{title}</h1>
          <div class="post-meta">
            <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
            <span class="separator">·</span>
            <span>{readingTime}</span>
            {showUpdated && (
              <>
                <span class="separator">·</span>
                <span class="updated">Updated {formattedUpdatedDate}</span>
              </>
            )}
          </div>
        </header>

        <div class="post-content">
          <slot />
        </div>
      </div>

      <aside class="margin-column">
        <!-- Margin notes will be positioned here via CSS -->
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .post-layout {
      grid-template-columns: var(--content-width) var(--sidebar-width);
      gap: var(--space-xl);
    }
  }

  .margin-column {
    display: none;
  }

  @media (min-width: 1024px) {
    .margin-column {
      display: block;
    }
  }

  .content-column {
    min-width: 0; /* Prevent overflow */
  }

  .post-header {
    margin-bottom: var(--space-xl);
  }

  .post-header h1 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .separator {
    color: var(--border);
  }

  .updated {
    font-style: italic;
  }

  .post-content {
    position: relative;
  }
</style>
